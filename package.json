{
  "name": "create",
  "version": "1.0.8",
  "description": "Create by Wagoo is a desktop application",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wagoo-app/create.git"
  },
  "build": {
    "appId": "app.wagoo.create",
    "productName": "Create by Wagoo",
    "win": {
      "target": "nsis",
      "icon": "assets/logo.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wagoo-app",
        "repo": "create"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  },
  "devDependencies": {
    "electron": "^41.7.0",
    "electron-builder": "^26.8.1"
  }
}
